{
  "name": "visual-docs-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compiles a markdown-superset doc set into one self-contained, offline HTML file.",
  "bin": {
    "visual-docs": "./build.mjs"
  },
  "scripts": {
    "demo": "node build.mjs ../examples/spec-demo --out /tmp/visual-docs-demo.html"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "highlight.js": "11.11.1",
    "mermaid": "11.6.0",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "3.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0"
  }
}
